# /etc/plex-dcr.env (root 600). The job never deletes anything.
DRY_RUN=1                 # 1 = score and log only, no Plex Janitor changes, no state saved
PUSHBULLET_TOKEN=
TARGET_TB=10              # fill "Leaving soon" until this much space is covered
MIN_DCR=60                # never list anything scoring lower than this
GRACE_DAYS=30             # days in "Leaving soon" before a title is offered for approval
EXCLUDE_SECTIONS=Workouts # comma-separated Plex library names to skip (e.g. Workouts,Kid Shows)
EXCLUDE_WATCHLISTED=1     # never list a title that's on anyone's Plex watchlist
SEERR_URL=https://nzb.n8io.com:5055
SEERR_API_KEY=
MAINTAINERR_URL=https://plex-janitor.n8io.com
MAINTAINERR_AUTH=         # basic-auth user:password in front of Plex Janitor
# Plex Janitor "Leaving soon" collection id per Plex library (collections are per library).
# Only libraries listed here can have titles put in Leaving soon.
LEAVING_SOON_COLLECTIONS=Movies=0,TV Shows=0,Kid Shows=0,Movies - Prerelease=0
REPORT_URL=               # optional link for the weekly push
