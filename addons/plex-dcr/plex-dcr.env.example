# /etc/plex-dcr.env (root 600). The job never deletes anything itself.
# 1 = score and log only, no Plex Janitor changes, no state saved
DRY_RUN=1
PUSHBULLET_TOKEN=
# size cap for "Leaving soon" in TB; 0 = no cap, list everything scoring MIN_DCR or more
TARGET_TB=0
# only titles scoring at least this are listed
MIN_DCR=64
# days in "Leaving soon" before a title is offered for approval
GRACE_DAYS=30
# 1 = add titles past the grace period to Plex "Approved for Deletion" (the daily n8n delete takes 25 per run)
AUTO_APPROVE=0
# comma-separated Plex library names to skip (e.g. Workouts,Kid Shows)
EXCLUDE_SECTIONS=Workouts
# never list a title that's on anyone's Plex watchlist
EXCLUDE_WATCHLISTED=1
SEERR_URL=https://nzb.n8io.com:5055
SEERR_API_KEY=
MAINTAINERR_URL=https://plex-janitor.n8io.com
# basic-auth user:password in front of Plex Janitor
MAINTAINERR_AUTH=
# Plex Janitor "Leaving soon" collection id per Plex library (collections are per library).
# Only libraries listed here can have titles put in Leaving soon.
# created 2026-11-15
LEAVING_SOON_COLLECTIONS=Movies=6,TV Shows=7,Kid Shows=8,Movies - Prerelease=9
# optional link for the weekly push
REPORT_URL=
