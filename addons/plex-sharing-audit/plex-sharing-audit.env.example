# /etc/plex-sharing-audit.env (root 600). The audit is read-only.
# Pushbullet: the quarterly reminder and failure alerts (installer copies it from /etc/plex-trash-clean.env)
PUSHBULLET_TOKEN=
# where the reminder push links to (the Claude project thread)
REMIND_URL=https://claude.ai/code/project/chan_01Fi8UwHDgQK8pxbdZBeBCZR?thread=cmsg_01Fi8UwHDgQK8pxbdZBeBCZRRY9JGF8YB4ycfkNfthUBhE
# Optional, only for running against the Tautulli API instead of a DB copy:
TAUTULLI_URL=https://plex-stats.n8io.com
TAUTULLI_API_KEY=
# Optional, only to email the report instead of printing it (Resend, n8io.com is verified)
RESEND_API_KEY=
EMAIL_FROM=N8Flix <n8flix-noreply@n8io.com>
EMAIL_TO=
# how far back each report looks (covers the quarter plus context for moves)
LOOKBACK_DAYS=180
# a "real" home needs a TV-type device, this many plays, and activity over more than TRIP_DAYS
MIN_HOME_PLAYS=10
TRIP_DAYS=14
# flag when two real homes overlap this many days, or stream at the same moment this many times
OVERLAP_DAYS=14
CONCURRENT_MIN=3
