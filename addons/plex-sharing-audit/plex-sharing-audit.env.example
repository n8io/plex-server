# /etc/plex-sharing-audit.env (root 600). The audit is read-only.
TAUTULLI_URL=https://plex-stats.n8io.com
# Tautulli > Settings > Web Interface > API key
TAUTULLI_API_KEY=
# Resend (n8io.com is a verified sending domain); comma-separated recipients
RESEND_API_KEY=
EMAIL_FROM=N8Flix <n8flix-noreply@n8io.com>
EMAIL_TO=
# failure alerts only
PUSHBULLET_TOKEN=
# how far back each report looks (covers the quarter plus context for moves)
LOOKBACK_DAYS=180
# a "real" home needs a TV-type device, this many plays, and activity over more than TRIP_DAYS
MIN_HOME_PLAYS=10
TRIP_DAYS=14
# flag when two real homes overlap this many days, or stream at the same moment this many times
OVERLAP_DAYS=14
CONCURRENT_MIN=3
